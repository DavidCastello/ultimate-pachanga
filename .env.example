# Copy to .env.local and fill in with the values printed by `npm run db:status`.
#
# Only publishable/anon keys belong here. A Supabase secret or service-role key
# in a VITE_ variable would be bundled into the JavaScript served to every
# visitor — never put one in this file.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_NAME=Roco Summer League
